# Example environment configuration for local dry runs and production deployment.
# Keep real credentials in a private .env/secret manager, not in git.

# ClientProfile SQL Server (read-only; used by python/db_connectors.py)
CLIENTPROFILE_SQL_SERVER=clientprofile-db-sqls.bank.lan
CLIENTPROFILE_SQL_PORT=1433
CLIENTPROFILE_SQL_DATABASE=ClientProfile
CLIENTPROFILE_SQL_DRIVER=ODBC Driver 17 for SQL Server
CLIENTPROFILE_SQL_TRUSTED_CONNECTION=yes
CLIENTPROFILE_SQL_USER=
CLIENTPROFILE_SQL_PASSWORD=
CLIENTPROFILE_SQL_ENCRYPT=yes
CLIENTPROFILE_SQL_TRUST_SERVER_CERTIFICATE=yes

# Oracle EWS / credit-contract source (read-only; optional)
ORACLE_DSN=
ORACLE_USER=READ_ONLY_USER
ORACLE_PASSWORD=
ORACLE_INSTANT_CLIENT_DIR=

# Dashboard defaults
EWS_DASHBOARD_HOST=127.0.0.1
EWS_DASHBOARD_PORT=8765
# Example environment configuration
CLIENTPROFILE_SQL_SERVER=clientprofile-db-sqls.bank.lan
CLIENTPROFILE_SQL_DATABASE=ClientProfile
CLIENTPROFILE_SQL_DRIVER=ODBC Driver 17 for SQL Server
CLIENTPROFILE_SQL_TRUSTED_CONNECTION=yes
ORACLE_DSN=
ORACLE_USER=READ_ONLY_USER
ORACLE_PASSWORD=
